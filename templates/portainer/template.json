{
  "type": 3,
  "title": "Portainer",
  "name": "portainer",
  "categories": [
    "Development"
  ],
  "category": "Development",
  "description": "Making Docker & Kubernetes management easy with a modern Web UI.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/portainer/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/portainer/icon.svg",
  "image": "portainer/portainer-ce:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/portainer/docker-compose.yml"
  },
  "env": [
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host path for Portainer database",
      "default": "./data/portainer"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}