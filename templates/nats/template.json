{
  "version": "2",
  "type": 1,
  "title": "NATS",
  "name": "nats",
  "category": "Infrastructure",
  "description": "Cloud-native microservices messaging system and JetStream persistence engine.",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/nats/icon.svg",
  "image": "nats:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/nats/docker-compose.yml"
  },
  "env": [
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host path for JetStream storage",
      "default": "./data/nats"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}