{
  "version": "2",
  "type": 1,
  "title": "Loki",
  "name": "loki",
  "category": "Monitoring",
  "description": "Like Prometheus, but for logs. High performance log aggregation system.",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/loki/icon.svg",
  "image": "grafana/loki:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/loki/docker-compose.yml"
  },
  "env": [
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host path for log index and chunk storage",
      "default": "./data/loki"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}