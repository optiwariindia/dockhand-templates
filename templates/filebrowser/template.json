{
  "type": 3,
  "title": "FileBrowser",
  "name": "filebrowser",
  "categories": [
    "Utilities"
  ],
  "category": "Utilities",
  "description": "Web-based file management interface to upload, edit, preview, and share files.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/filebrowser/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/filebrowser/icon.svg",
  "image": "filebrowser/filebrowser:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/filebrowser/docker-compose.yml"
  },
  "env": [
    {
      "name": "DATA_PATH",
      "label": "Shared Directory Path",
      "description": "Host path for managed storage files",
      "default": "./data/filebrowser/files"
    },
    {
      "name": "DATABASE_PATH",
      "label": "Database Path",
      "description": "Host path for filebrowser.db SQLite file",
      "default": "./data/filebrowser/filebrowser.db"
    },
    {
      "name": "CONFIG_PATH",
      "label": "Config Path",
      "description": "Host path for settings.json",
      "default": "./config/filebrowser/settings.json"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}