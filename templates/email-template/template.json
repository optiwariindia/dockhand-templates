{
  "type": 3,
  "title": "Email Template Service (Om Prakash Tiwari)",
  "name": "email-template",
  "categories": [
    "Microservices"
  ],
  "category": "Microservices",
  "description": "HTML Email Template rendering and live preview server.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/email-template/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/email-template/icon.svg",
  "image": "optiwariindia/email-template:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/email-template/docker-compose.yml"
  },
  "env": [
    {
      "name": "TEMPLATE_DIR",
      "label": "Template Directory Path",
      "description": "Host path for custom HTML templates",
      "default": "./data/email-templates"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}