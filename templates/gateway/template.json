{
  "version": "2",
  "type": 1,
  "title": "API Gateway (Om Prakash Tiwari)",
  "name": "gateway",
  "category": "Reverse Proxy",
  "description": "Lightweight API Gateway service for routing microservice requests.",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/gateway/icon.svg",
  "image": "optiwariindia/gateway:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/gateway/docker-compose.yml"
  },
  "env": [
    {
      "name": "CONFIG_PATH",
      "label": "Config Directory Path",
      "description": "Host path for gateway routes configuration",
      "default": "./config/gateway"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}