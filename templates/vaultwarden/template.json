{
  "type": 3,
  "title": "Vaultwarden",
  "name": "vaultwarden",
  "categories": [
    "Utilities"
  ],
  "category": "Utilities",
  "description": "Unofficial Bitwarden compatible server written in Rust, light on memory.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/vaultwarden/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/vaultwarden/icon.svg",
  "image": "vaultwarden/server:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/vaultwarden/docker-compose.yml"
  },
  "env": [
    {
      "name": "WEBSOCKET_ENABLED",
      "label": "Enable WebSockets",
      "description": "Enable WebSocket notifications",
      "default": "true"
    },
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host directory for vault database & attachments",
      "default": "./data/vaultwarden"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}