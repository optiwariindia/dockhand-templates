{
  "version": "2",
  "type": 1,
  "title": "WireGuard",
  "name": "wireguard",
  "category": "Networking",
  "description": "Extremely simple yet fast and modern VPN server.",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/wireguard/icon.svg",
  "image": "lscr.io/linuxserver/wireguard:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/wireguard/docker-compose.yml"
  },
  "env": [
    {
      "name": "PUID",
      "label": "User ID",
      "description": "Process User ID",
      "default": "1000"
    },
    {
      "name": "PGID",
      "label": "Group ID",
      "description": "Process Group ID",
      "default": "1000"
    },
    {
      "name": "SERVERURL",
      "label": "Server Public IP / Domain",
      "description": "Public domain or IP address for clients to connect",
      "default": "wireguard.example.com"
    },
    {
      "name": "SERVERPORT",
      "label": "Server Port",
      "description": "External UDP Port",
      "default": "51820"
    },
    {
      "name": "PEERS",
      "label": "Number of Peers",
      "description": "Number of client configuration files to generate",
      "default": "5"
    },
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host directory for generated configs & keys",
      "default": "./data/wireguard"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}