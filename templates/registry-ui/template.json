{
  "type": 3,
  "title": "Registry UI",
  "name": "registry-ui",
  "categories": [
    "Development"
  ],
  "category": "Development",
  "description": "User interface for private Docker registries to search and manage container tags.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/registry-ui/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/registry-ui/icon.svg",
  "image": "joxit/docker-registry-ui:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/registry-ui/docker-compose.yml"
  },
  "env": [
    {
      "name": "REGISTRY_TITLE",
      "label": "Registry Title",
      "description": "UI Display Title",
      "default": "My Private Registry"
    },
    {
      "name": "REGISTRY_URL",
      "label": "Registry Service URL",
      "description": "URL of the target Registry v2 service",
      "default": "http://registry:5000"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}