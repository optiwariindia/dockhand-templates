{
  "version": "2",
  "type": 1,
  "title": "Caddy",
  "name": "caddy",
  "category": "Reverse Proxy",
  "description": "Powerful, enterprise-ready open-source web server with automatic HTTPS.",
  "icon": "templates/caddy/icon.svg",
  "image": "caddy:2-alpine",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/dockhand-templates",
    "stackfile": "templates/caddy/docker-compose.yml"
  },
  "env": [
    {
      "name": "CONFIG_PATH",
      "label": "Config Directory Path",
      "description": "Host directory for Caddyfile",
      "default": "./config/caddy"
    },
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host directory for certificates & state",
      "default": "./data/caddy"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}