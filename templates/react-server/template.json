{
  "type": 3,
  "title": "React Application Server (Om Prakash Tiwari)",
  "name": "react-server",
  "categories": [
    "Development"
  ],
  "category": "Development",
  "description": "React web application web server and static asset host.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/react-server/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/react-server/icon.svg",
  "image": "optiwariindia/react-server:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/react-server/docker-compose.yml"
  },
  "env": [
    {
      "name": "PUBLIC_DIR",
      "label": "Public Directory Path",
      "description": "Host directory containing built static files",
      "default": "./data/react-app"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}