{
  "version": "2",
  "type": 1,
  "title": "Excel Microservice (Om Prakash Tiwari)",
  "name": "excel",
  "category": "Utilities",
  "description": "Excel spreadsheet parsing, data generation, and transformation API.",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/excel/icon.svg",
  "image": "optiwariindia/excel:latest",
  "administrator_only": false,
  "repository": {
