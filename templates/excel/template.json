    "stackfile": "templates/excel/docker-compose.yml"
  },
  "env": [
    {
      "name": "PORT",
      "label": "HTTP Port",
      "description": "Server listening port",
      "default": "3000"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
