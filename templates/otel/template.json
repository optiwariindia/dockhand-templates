{
  "type": 3,
  "title": "OpenTelemetry Collector (Om Prakash Tiwari)",
  "name": "otel",
  "categories": [
    "Monitoring"
  ],
  "category": "Monitoring",
  "description": "OpenTelemetry Collector container for metrics, logs, and traces pipeline.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/otel/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/otel/icon.svg",
  "image": "optiwariindia/otel:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/otel/docker-compose.yml"
  },
  "env": [
    {
      "name": "CONFIG_PATH",
      "label": "Config Directory Path",
      "description": "Host path for otel-collector-config.yaml",
      "default": "./config/otel"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}