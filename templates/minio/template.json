{
  "version": "2",
  "type": 1,
  "title": "MinIO",
  "name": "minio",
  "category": "Infrastructure",
  "description": "High-performance S3-compatible object storage server.",
  "icon": "templates/minio/icon.svg",
  "image": "minio/minio:RELEASE.2024-11-07T00-52-20Z",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/dockhand-templates",
    "stackfile": "templates/minio/docker-compose.yml"
  },
  "env": [
    {
      "name": "MINIO_ROOT_USER",
      "label": "Root Access Key",
      "description": "MinIO admin user/access key",
      "default": "minioadmin"
    },
    {
      "name": "MINIO_ROOT_PASSWORD",
      "label": "Root Secret Key",
      "description": "MinIO admin secret key (min 8 chars)",
      "default": "minioadmin123"
    },
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host directory for object storage data",
      "default": "./data/minio"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}