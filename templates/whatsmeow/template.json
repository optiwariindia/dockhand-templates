{
  "type": 3,
  "title": "Whatsmeow Listener (Om Prakash Tiwari)",
  "name": "whatsmeow",
  "categories": [
    "Microservices"
  ],
  "category": "Microservices",
  "description": "Lightweight listener and API service for WhatsApp events and webhooks.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/whatsmeow/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/whatsmeow/icon.svg",
  "image": "optiwariindia/whatsmeow:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/whatsmeow/docker-compose.yml"
  },
  "env": [
    {
      "name": "SESSION_PATH",
      "label": "Session Directory Path",
      "description": "Host directory for persistent WhatsApp SQLite session DB",
      "default": "./data/whatsmeow"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}