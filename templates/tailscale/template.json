{
  "type": 3,
  "title": "Tailscale",
  "name": "tailscale",
  "categories": [
    "Networking"
  ],
  "category": "Networking",
  "description": "Zero-config VPN that creates a secure mesh network among all your devices.",
  "platform": "linux",
  "restart_policy": "unless-stopped",
  "logo": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/tailscale/icon.svg",
  "icon": "https://raw.githubusercontent.com/optiwariindia/dockhand-templates/main/templates/tailscale/icon.svg",
  "image": "tailscale/tailscale:latest",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/optiwariindia/dockhand-templates",
    "stackfile": "templates/tailscale/docker-compose.yml"
  },
  "env": [
    {
      "name": "TS_AUTHKEY",
      "label": "Auth Key",
      "description": "Tailscale reusable or ephemeral authentication key",
      "default": ""
    },
    {
      "name": "TS_EXTRA_ARGS",
      "label": "Extra Arguments",
      "description": "Additional flags (e.g. --advertise-routes=192.168.1.0/24)",
      "default": "--advertise-exit-node"
    },
    {
      "name": "TS_STATE_DIR",
      "label": "State Directory Path",
      "description": "Host directory for persistent state",
      "default": "./data/tailscale"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}