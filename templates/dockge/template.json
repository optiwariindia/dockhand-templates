{
  "version": "2",
  "type": 1,
  "title": "Dockge",
  "name": "dockge",
  "category": "Development",
  "description": "A slick, user-friendly & reactive self-hosted Docker Compose manager.",
  "icon": "templates/dockge/icon.svg",
  "image": "louislam/dockge:1",
  "administrator_only": false,
  "repository": {
    "url": "https://github.com/dockhand-templates",
    "stackfile": "templates/dockge/docker-compose.yml"
  },
  "env": [
    {
      "name": "STACKS_DIR",
      "label": "Stacks Directory",
      "description": "Host path where Docker compose stacks are stored",
      "default": "/opt/stacks"
    },
    {
      "name": "DATA_PATH",
      "label": "Data Directory Path",
      "description": "Host path for Dockge database",
      "default": "./data/dockge"
    },
    {
      "name": "TZ",
      "label": "Timezone",
      "description": "Container timezone",
      "default": "UTC"
    }
  ]
}